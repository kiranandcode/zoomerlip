{
  "name": "zoomerlip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:local": "node scripts/test-local.mjs",
    "test:demo": "node scripts/test-demo.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.json *.ts index.html README.md",
    "format:check": "prettier --check src tests scripts/*.mjs *.json *.ts index.html README.md",
    "test:scale": "node scripts/test-scale.mjs",
    "test:themes": "node scripts/test-themes.mjs",
    "test:messaging": "node scripts/test-messaging.mjs",
    "test:notifications": "node scripts/test-notifications.mjs",
    "test:registration": "node scripts/test-registration.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:safety": "node scripts/test-safety.mjs",
    "test:organisation": "node scripts/test-organisation.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
