{
	admin unix//run/caddy/admin.sock
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	servers {
		protocols h1
	}
}

# Explicit HTTP sites ensure the protocol setting also covers redirects.
http://zoomerlip.kirancodes.me, http://kalshitrader.kirancodes.me {
	redir https://{host}{uri} permanent
}

zoomerlip.kirancodes.me {
	root * /srv/zoomerlip/current
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: http://localhost:* http://127.0.0.1:*; font-src 'self'; connect-src https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	@private path /.git* /.env* /local/* /ops/* /node_modules/* /src/*
	respond @private 404
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Preserve the existing dashboard, webhook, and WebSocket routing.
kalshitrader.kirancodes.me {
	handle /deploy-webhook {
		reverse_proxy 127.0.0.1:9000 {
			header_up X-Real-IP {remote_host}
			transport http {
				versions 1.1
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Real-IP {remote_host}
			transport http {
				versions 1.1
				dial_timeout 75s
				response_header_timeout 300s
				read_timeout 300s
			}
		}
	}
}
